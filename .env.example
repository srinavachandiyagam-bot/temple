# ====================================================================
# Nava Chandi Yagam - Environment Variables
# ====================================================================

# 0. Local Mock Mode (Set to true to test locally without PostgreSQL or Cashfree)
# When MOCK_MODE=true:
# - Uses an in-memory database store (no PostgreSQL required)
# - Uses a simulated Cashfree Payment Gateway (no Cashfree API keys required)
MOCK_MODE=true

# 1. Server Configuration
PORT=3000
NODE_ENV=development

# Admin Panel Login Password
# Change this before deploying to production!
ADMIN_PASSWORD=change-this-password

# 2. Database Connection URL
# By default, uses persistent SQLite stored in data/temple.db (zero-setup, no server needed)
# To use PostgreSQL (Supabase, Neon, Railway, or local Postgres), uncomment and configure:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nava_chandi_yagam
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST].neon.tech/neondb?sslmode=require
DATABASE_URL=

# 3. Cashfree API Credentials
# When MOCK_MODE=false, get your keys from: https://merchants.cashfree.com -> Developers -> API Keys
CASHFREE_APP_ID=TEST10000000000000000000000000000001
CASHFREE_SECRET_KEY=TEST0000000000000000000000000000000000000001

# Cashfree Webhook Secret Key
# Found in: Cashfree Dashboard -> Developers -> Webhooks
CASHFREE_WEBHOOK_SECRET=TEST0000000000000000000000000000000000000001

# Mode: 'sandbox' (testing) or 'production' (live transactions)
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# 4. Event Registration Amount (in INR)
REGISTRATION_AMOUNT=1000.00

# 5. Public Website & Domain URL (CRITICAL FOR HOSTINGER)
# Set this to your live Hostinger custom domain:
# e.g., https://yourtempledomain.com or https://nava-chandi-yagam.com
PUBLIC_BASE_URL=https://yourtempledomain.com

# Optional granular overrides (defaults to PUBLIC_BASE_URL if left empty)
CLIENT_URL=
SERVER_URL=
