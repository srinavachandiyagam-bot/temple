# ====================================================================
# Nava Chandi Yagam - Environment Variables (PhonePe ONLY)
# ====================================================================

# 0. Local Mock Mode (Set to true to test locally without PostgreSQL or PhonePe)
# When MOCK_MODE=true:
# - Uses an in-memory database store (no PostgreSQL required)
# - Uses a simulated PhonePe Payment Gateway (no PhonePe credentials required)
MOCK_MODE=true

# 1. Server Configuration
PORT=3000
NODE_ENV=development

# Admin Panel Login Password
# Change this before deploying to production!
ADMIN_PASSWORD=change-this-password

# 2. Database Connection URL
# By default, uses persistent SQLite stored in data/temple.db (zero-setup, no server needed)
# To use PostgreSQL (Supabase, Neon, Railway, or local Postgres), uncomment and configure:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nava_chandi_yagam
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST].neon.tech/neondb?sslmode=require
DATABASE_URL=

# 3. PhonePe Payment Gateway Credentials (REQUIRED for live payments)
# Get values from: PhonePe Business Dashboard -> Developer Settings
# Docs: https://developer.phonepe.com/payment-gateway/website-integration/standard-checkout/api-integration
PHONEPE_CLIENT_ID=your_phonepe_client_id_here
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret_here
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox

# PhonePe Webhook / S2S Callback Authentication
# Configure in PhonePe Dashboard -> Webhook Settings (SHA username/password method)
PHONEPE_CALLBACK_USERNAME=your_webhook_username
PHONEPE_CALLBACK_PASSWORD=your_webhook_password
# Optional HMAC fallback (if using HMAC webhook type)
PHONEPE_WEBHOOK_SECRET=

# 4. Fixed Participation Amount (Server-enforced, do NOT change)
# The amount is FIXED at ₹999 – the backend enforces this and ignores any browser-supplied value.
# PhonePe requires amount in paise: 99900
REGISTRATION_AMOUNT=999.00
PARTICIPATION_AMOUNT=999

# 4b. Persistent Media Storage - Cloudflare R2 (S3 Compatible) - REQUIRED for production
# Without R2, photos/videos stored on local disk are EPHEMERAL and disappear after deploy/restart on Render/Hostinger free tiers.
# Create a free R2 bucket at https://dash.cloudflare.com -> R2 -> Create Bucket
# Then create API Token with Object Read & Write, and enable Public Access via R2.dev or Custom Domain.
# Environment variables:
# R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com  (from R2 Overview -> S3 API)
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET=nava-chandi-media
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev  OR https://media.navachandiyagam.online (custom domain)
# R2_REGION=auto
# If any R2 variable is missing, uploads fallback to local disk (ephemeral - not recommended for production)
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
# R2_REGION=auto

# 5. Public Website & Domain URL (CRITICAL FOR HOSTINGER)
# Set this to your live Hostinger custom domain:
# e.g., https://yourtempledomain.com or https://nava-chandi-yagam.com
# Used for PhonePe redirectUrl: {PUBLIC_BASE_URL}/?order_id={merchantOrderId}
# And PhonePe webhook: {PUBLIC_BASE_URL}/api/phonepe/callback
PUBLIC_BASE_URL=https://yourtempledomain.com

# Optional granular overrides (defaults to PUBLIC_BASE_URL if left empty)
CLIENT_URL=
SERVER_URL=
